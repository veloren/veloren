BasicRanged(
    energy_cost: 30,
    buildup_duration: 0.3,
    recover_duration: 0.6,
    projectile: (
        kind: Simple,
        attack: Some((
            damage: 6.5,
            without_combo: true,
            damage_kind: Piercing,
        )),
        split: Some((
            split_on_terrain: false,
            amount: 15,
            spread: 0.25,
            new_lifetime: 15.0,
            override_collider: Some((
                p0: (x: 0, y: 0),
                p1: (x: 0, y: 0),
                radius: 1.0,
                z_min: -1.0,
                z_max: 1.0,
